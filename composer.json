{
    "name": "sierratecnologia/integrations",
    "description": "Integrations de Serviços",
    "type": "library",
    "keywords": [
        "sierratecnologia",
        "integrations"
    ],
    "license": "MIT",
    "homepage": "https://sierratecnologia.com/packages/integrations/",
    "support": {
        "email": "help@sierratecnologia.com",
        "issues": "https://github.com/sierratecnologia/integrations/issues",
        "source": "https://github.com/sierratecnologia/integrations",
        "docs": "https://github.com/sierratecnologia/integrations/blob/master/README.md"
    },
    "authors": [
        {
            "name": "SierraTecnologia",
            "homepage": "https://sierratecnologia.com.br",
            "email": "help@sierratecnologia.com.br"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.10",
        "league/climate": "^3.12",
        "league/csv": "^9.28",
        "league/pipeline": "^1.1",
        "league/plates": "^3.6",
        "m4tthumphrey/php-gitlab-api": "^12.1",
        "phpfastcache/phpfastcache": "^9.2",
        "ricasolucoes/atlassian": "^2.0",
        "sabre/xml": "^4.1",
        "sierratecnologia/muleta": "^2.0"
    },
    "suggest": {
        "aws/aws-sdk-php": "^3.394 - Needed for AWS S3 and cloud integration services",
        "geerlingguy/ping": "^1.2 - Needed for server ping/latency check tool",
        "hubspot/hubspot-php": "^5.4 - Needed for HubSpot CRM connector",
        "league/flysystem-aws-s3-v3": "^3.35 - Needed for AWS S3 Flysystem storage adapter"
    },
    "autoload": {
        "psr-4": {
            "Integrations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Integrations\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "psalm": "vendor/bin/psalm",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "post-install-cmd": [],
        "post-update-cmd": [],
        "post-create-project-cmd": []
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^13.0",
        "phpro/grumphp": "^2.12"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "phpro/grumphp": true,
            "php-http/discovery": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../**",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Integrations\\IntegrationsProvider"
            ],
            "dont-discover": [
                "laravel/cashier"
            ]
        }
    },
    "version": "2.3.0"
}
